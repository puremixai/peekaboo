# 复制为 .env 后填入自己的高德 Key：
#   cp .env.example .env
#
# Key 申请入口：https://console.amap.com/dev/key/app

# 【必填】高德「Web 服务」Key。
# 只用于服务端调用路径规划与输入提示，不会出现在浏览器里。
AMAP_WEB_KEY=

# 【强烈建议单独申请】高德「Web 端(JS API)」Key。
# 这个 Key 必然会被下发到浏览器，务必在高德控制台配置 Referer 域名白名单
# （本地调试可加 localhost）。留空则复用 AMAP_WEB_KEY。
AMAP_JS_KEY=

# 【可选】JS API 2.0 的安全密钥。填了会启用 _AMapSecurityConfig。
AMAP_SECURITY_CODE=

# 【可选】对外端口，默认 8080
PORT=8080

# 【可选】输入提示限定的城市
AMAP_CITY=北京

# 【可选】是否打印每个请求（排查问题时开）
LOG_REQUESTS=false

# 【可选】单次调用高德接口的超时（秒）
AMAP_TIMEOUT_SEC=20
