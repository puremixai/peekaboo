# 复制为 .env 后填入自己的高德 Key：
#   cp .env.example .env
#
# Key 申请入口：https://console.amap.com/dev/key/app

# 【必填】高德「Web 服务」Key。
# 只用于服务端调用路径规划与输入提示，不会出现在浏览器里。
AMAP_WEB_KEY=

# 【强烈建议单独申请】高德「Web 端(JS API)」Key。
# 这个 Key 必然会被下发到浏览器，务必在高德控制台配置 Referer 域名白名单
# （本地调试可加 localhost）。留空则复用 AMAP_WEB_KEY。
AMAP_JS_KEY=

# 【可选但推荐】JS API 2.0 的安全密钥（securityJsCode）。
# 填了之后本服务会自动启用高德官方推荐的「代理服务器转发」模式：
#   前端只拿到 serviceHost = http(s)://你的域名/_AMapService 这个地址，
#   真实密钥留在服务端，由 Go 在转发时补上 &jscode=xxx。
# 这样 DevTools 里看不到安全密钥；不填则前端不设 _AMapSecurityConfig，按无安全密钥方式加载。
#
# 注意：key 本身（AMAP_JS_KEY）仍会出现在 <script src="...&key=..."> 里，
# 这是 JS API 的固有设计，藏不住，只能靠高德控制台的 Referer 白名单防护。
AMAP_SECURITY_CODE=

# 【可选】对外端口，默认 8080
PORT=8080

# 【可选】输入提示限定的城市
AMAP_CITY=北京

# 【可选】是否打印每个请求（排查问题时开）
LOG_REQUESTS=false

# 【可选】单次调用高德接口的超时（秒）
AMAP_TIMEOUT_SEC=20
